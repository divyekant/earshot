    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "Engineer: Farid from Northgate Heating, came on 21 October."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "The boiler is a Calderline 28 combi, fitted in 2017."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "Service cost £95, paid by card."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "He cleaned the condensate trap and replaced the seal on the flue."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "Pressure was low at 0.6 bar; he topped it up to 1.2 bar."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "The expansion vessel is fine."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "He said the pump makes a noise at start-up and may need replacing within two years. A new pump costs about £280 fitted."
    },
    {
      "inMain": false,
      "k": "p",
      "links": 0,
      "t": "Next service due: October next year. Book in August, because the autumn fills up fast."
    }
